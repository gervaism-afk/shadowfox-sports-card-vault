NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI card identification. Reuse the key in Vercel; never prefix it NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional override for a model supporting image input and structured output.
OPENAI_VISION_MODEL=gpt-4.1-mini

# OpenRouter alternative (server-only); takes precedence over OPENAI_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
